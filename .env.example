# Copie este archivo como ".env" (en esta misma carpeta) para cambiar la configuracion de docker compose.
# El archivo ".env" NO se sube a GitHub: ahi van sus claves reales.
#
# ---------------------------------------------------------------------------------------------
# CORREO
# Por defecto el sistema usa Mailpit (un buzon falso que vive en Docker, http://localhost:8025):
# los correos "se envian" pero solo se ven ahi, no llegan a ninguna bandeja real.
# Para que lleguen a bandejas reales descomente UNA de estas opciones.
# ---------------------------------------------------------------------------------------------

# --- Opcion A: Gmail (gratis, hasta ~500 correos al dia; basta para el proyecto) -----------------
# 1) Active la verificacion en 2 pasos de la cuenta: https://myaccount.google.com/security
# 2) Cree una "contrasena de aplicacion": https://myaccount.google.com/apppasswords
# 3) Pegue aqui el correo y esa contrasena de 16 letras (NO la clave normal de la cuenta).
# CORREO_HABILITADO=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USUARIO=micuenta@gmail.com
# SMTP_CLAVE=abcdefghijklmnop
# CORREO_REMITENTE=micuenta@gmail.com

# --- Opcion B: Brevo (gratis, 300 correos al dia; https://www.brevo.com) ------------------------
# CORREO_HABILITADO=true
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USUARIO=su-usuario-smtp-de-brevo
# SMTP_CLAVE=su-clave-smtp-de-brevo
# CORREO_REMITENTE=remitente-verificado@sudominio.com

# Direccion que se escribe en los enlaces de los correos (cambiela cuando se despliegue en Render).
# URL_SISTEMA=http://localhost:4200

# Clave con la que se firman las sesiones (JWT). Use una larga y secreta fuera de su computador.
# JWT_SECRETO=cambie-esto-por-una-frase-larga-de-mas-de-32-caracteres
